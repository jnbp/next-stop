<?xml version="1.0" encoding="utf-8"?>
<!--
    The small icon of every notification: the app logo (an arrow into a ring) as solid,
    one-colour shapes, simple enough to read at 16 px in the status bar and the Live Update chip.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The shaft of the arrow, rounded at its tail. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3.4,10.6H8.2V13.4H3.4A1.4,1.4 0,0 1,3.4 10.6Z" />
    <!-- The head of the arrow. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7,7.2L11.6,12L7,16.8Z" />
    <!-- The ring: the next stop. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M13,12a4.8,4.8 0,1 0,9.6 0a4.8,4.8 0,1 0,-9.6 0ZM15.6,12a2.2,2.2 0,1 0,4.4 0a2.2,2.2 0,1 0,-4.4 0Z" />
</vector>
