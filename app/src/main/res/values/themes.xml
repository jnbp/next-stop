<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.NextStop" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
        The main page: the splash screen of Android 12+ shows the arrow gliding into the lime stop on the
        blue of the icon, then hands over to the app (see MainActivity).
    -->
    <style name="Theme.NextStop.Main" parent="Theme.NextStop">
        <item name="android:windowSplashScreenBackground">@color/trip_blue</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">900</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/trip_blue</item>
    </style>
</resources>
