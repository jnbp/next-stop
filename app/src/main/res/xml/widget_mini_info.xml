<?xml version="1.0" encoding="utf-8"?>
<!-- Mini: 1x1 by default, grows to 2x1 with two departures. The data comes from WorkManager and WidgetUpdates, so updatePeriodMillis is 0. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="io.github.jnbp.nextstop.widget.WidgetConfigActivity"
    android:description="@string/widget_mini_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="180dp"
    android:maxResizeHeight="110dp"
    android:previewLayout="@layout/widget_preview_mini"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
