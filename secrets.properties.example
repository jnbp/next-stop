# Keys built into the app. Copy this file to secrets.properties (gitignored) in the project
# root and fill in what you have; empty or missing keys are fine. See docs/keys.md.
# Never commit secrets.properties, never paste keys into issues, logs or screenshots.

# App token of accessibility.cloud (lifts of BVG, S-Bahn and DB stations)
accessibilityCloudToken=

# accessId of the official VBB HAFAS API
vbbAccessId=

# Optional: DB API Marketplace, FaSta (lifts and escalators at DB stations)
fastaClientId=
fastaApiKey=
